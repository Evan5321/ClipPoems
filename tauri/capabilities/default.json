{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "ClipPoems 桌面端默认权限：窗口、对话框与文件读写",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:default",
    "fs:allow-write-file",
    "fs:allow-read-text-file"
  ]
}
